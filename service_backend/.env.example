# Postgres everywhere (SQLite dropped). Bootstrap with: python -m scripts.bootstrap_db
DATABASE_URL=postgresql://foundryx:foundryx@localhost:5432/foundryx_service
# Admin connection bootstrap_db uses to create the role + database (maintenance db).
POSTGRES_ADMIN_URL=postgresql://postgres@localhost:5432/postgres

JWT_SECRET=change_me_generate with: openssl rand -base64 32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

API_HOST=0.0.0.0
API_PORT=8001

# Frontend origin for invite / set-password / reset links.
FRONTEND_URL=http://localhost:3001

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
ENVIRONMENT=development
DEBUG=true

# ── Omnichannel module (WhatsApp BSP, Route A = Tech Provider) ──
# Leave empty for dev (simulated Embedded Signup). Fill to go live - see
# documentation/plans/sprint-1/04-omnichannel-embedded-signup-runbook.md
META_APP_ID=
META_APP_SECRET=
META_ES_CONFIG_ID=
META_GRAPH_VERSION=v19.0
# Stable key for encrypting channel credentials at rest (REQUIRED in prod):
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
OMNICHANNEL_FERNET_KEY=

# ── Integration core (plan 09) ───────────────────────────────────────────────
# Core Fernet key for connection credentials at rest (REQUIRED in prod -
# generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=

# Platform-default SMTP - seeded into the platform tenant's connection at
# bootstrap. Unset host = no row = dev console-log emails.
PLATFORM_SMTP_HOST=
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_SECURITY=starttls
PLATFORM_SMTP_USERNAME=
PLATFORM_SMTP_PASSWORD=
PLATFORM_SMTP_FROM_EMAIL=
PLATFORM_SMTP_FROM_NAME=Foundryx EMS

# Email outbox dispatcher
EMAIL_OUTBOX_RETENTION_DAYS=90
EMAIL_DISPATCH_INTERVAL_SECONDS=2.0
EMAIL_SEND_TIMEOUT_SECONDS=10
