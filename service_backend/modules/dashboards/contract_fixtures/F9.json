{
  "id": "F9",
  "call": "save/share/delete",
  "key": "sorento",
  "setup": [
    "owner_dashboard",
    "share_viewer"
  ],
  "cases": [
    {
      "name": "save",
      "request": {
        "method": "POST",
        "path": "/api/v1/dashboards/save",
        "body": {
          "actor_ref": "u-viewer-1",
          "dashboard_id": "{dashboard_id}",
          "name": "Sales overview",
          "spec": {
            "version": 1,
            "title": "Sales overview",
            "period": "this_year",
            "tiles": [
              {
                "id": "t1",
                "title": "Invoiced sales by month",
                "show": "line",
                "source": {
                  "kind": "query",
                  "spec": {
                    "entity": "billing_document",
                    "group_by": [
                      {
                        "field": "doc_date",
                        "bucket": "month"
                      }
                    ],
                    "aggregates": [
                      {
                        "fn": "sum",
                        "field": "sales_amount"
                      }
                    ]
                  }
                }
              },
              {
                "id": "t2",
                "title": "Top 10 customers",
                "show": "table",
                "source": {
                  "kind": "query",
                  "spec": {
                    "entity": "billing_document",
                    "group_by": [
                      "customer_name"
                    ],
                    "aggregates": [
                      {
                        "fn": "sum",
                        "field": "sales_amount"
                      }
                    ],
                    "sort": [
                      {
                        "field": "sum_sales_amount",
                        "dir": "desc"
                      }
                    ],
                    "limit": 10
                  }
                }
              }
            ]
          },
          "base_version": 2,
          "idempotency_key": "9b1c7e2a-0000-4000-8000-000000000007"
        }
      },
      "response": {
        "status": 403,
        "body": {
          "error": "not_owner",
          "message": "A plain sentence."
        }
      }
    },
    {
      "name": "share",
      "request": {
        "method": "POST",
        "path": "/api/v1/dashboards/{dashboard_id}/share",
        "body": {
          "actor_ref": "u-viewer-1",
          "shared_with": [
            {
              "user_ref": "u-other-1"
            }
          ]
        }
      },
      "response": {
        "status": 403,
        "body": {
          "error": "not_owner",
          "message": "A plain sentence."
        }
      }
    },
    {
      "name": "delete",
      "request": {
        "method": "POST",
        "path": "/api/v1/dashboards/{dashboard_id}/delete",
        "body": {
          "actor_ref": "u-viewer-1"
        }
      },
      "response": {
        "status": 403,
        "body": {
          "error": "not_owner",
          "message": "A plain sentence."
        }
      }
    }
  ]
}
