# FoundryX EMS — server-side production env (root). Copy to `.env` on the deploy
# server (NEVER commit the real .env). docker-compose.yml reads these.
# Generate Fernet keys: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Generate secrets:     openssl rand -base64 32

# ── Image / registry ─────────────────────────────────────────────────────────
IMAGE_REPO=jayson1004/foundryx-ems
# IMAGE_TAG is exported by the deploy script (git SHA) — do not set here.

# ── Postgres (compose db service) ────────────────────────────────────────────
POSTGRES_USER=foundryx
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=foundryx_service

# ── Backend secrets (REQUIRED) ───────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_openssl_rand_base64_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FERNET_KEY=CHANGE_ME_fernet_key
OMNICHANNEL_FERNET_KEY=CHANGE_ME_fernet_key
BACKEND_WORKERS=4

# ── URLs / CORS ──────────────────────────────────────────────────────────────
# SINGLE-DOMAIN model (no extra DNS): frontend at root, backend under /be (Caddy
# strips the prefix). FRONTEND_URL = app root (invite/reset links point here).
FRONTEND_URL=https://icp-demo.foundryx.my
NEXTAUTH_URL=https://icp-demo.foundryx.my
CORS_ORIGINS=https://icp-demo.foundryx.my
NEXTAUTH_SECRET=CHANGE_ME_openssl_rand_base64_32
# Browser-facing backend base = app domain + /be. Used by the frontend (BAKED
# into the image at build via NEXT_PUBLIC_*) AND by the backend's own absolute
# URLs (PUBLIC_BASE_URL — avatars/branding/media). Keep both identical.
NEXT_PUBLIC_BACKEND_API_URL=https://icp-demo.foundryx.my/be
PUBLIC_BASE_URL=https://icp-demo.foundryx.my/be

# ── Omnichannel / Meta WhatsApp (optional — empty = dev-safe simulated) ──────
META_APP_ID=
META_APP_SECRET=
META_ES_CONFIG_ID=
META_GRAPH_VERSION=v19.0
META_WEBHOOK_VERIFY_TOKEN=
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_ES_CONFIG_ID=
NEXT_PUBLIC_META_GRAPH_VERSION=v19.0

# ── Platform SMTP (optional — unset = console-log emails) ────────────────────
PLATFORM_SMTP_HOST=
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_SECURITY=starttls
PLATFORM_SMTP_USERNAME=
PLATFORM_SMTP_PASSWORD=
PLATFORM_SMTP_FROM_EMAIL=
PLATFORM_SMTP_FROM_NAME=FoundryX EMS
