{
  "module_name": "ems",
  "version": "2.0.0",
  "author": "Dreamz",
  "title": "Events",
  "description": "Event Management — profiles, event types and templates, events, and participant registration with two-tier eligibility. Leads/quotations now live in the CRM module; the product catalog is core.",
  "icon": "calendar",
  "required_core_version": ">=1.0.0",
  "schema": "app_ems",
  "alembic_version_table": "alembic_version_ems",
  "requires": [
    { "name": "finance", "version": ">=1.0.0" }
  ],
  "optional": [
    { "name": "omnichannel", "version": ">=0.1.0" },
    { "name": "crm", "version": ">=1.0.0" }
  ],
  "provides": [
    { "capability": "profile.resolve", "version": 1 },
    { "capability": "participant.resolve", "version": 1 },
    { "capability": "project.create_from_template", "version": 1 },
    { "capability": "projects.by_lead", "version": 1 },
    { "capability": "projects.by_client", "version": 1 }
  ],
  "routers": [
    { "name": "profiles", "prefix": "/ems/profiles" },
    { "name": "project_types", "prefix": "/ems/project-types" },
    { "name": "project_templates", "prefix": "/ems/project-templates" },
    { "name": "projects", "prefix": "/ems/projects" },
    { "name": "offerings", "prefix": "/ems/projects" },
    { "name": "venues", "prefix": "/ems/venues" },
    { "name": "personas", "prefix": "/ems/personas" },
    { "name": "public_register", "prefix": "/public/register", "public": true },
    { "name": "portal_auth", "prefix": "/portal/auth", "public": true },
    { "name": "portal", "prefix": "/portal", "public": true },
    { "name": "portal_review", "prefix": "/portal", "public": true }
  ],
  "permissions_csv": "permissions/permissions.csv"
}
