exports[`parity (switch off): impersonation banner > collapsed renders as before 1`] = `"<div><button type="button" title="Show impersonation banner" class="fixed end-3 top-2 z-(--z-banner) flex items-center gap-1 rounded-full border border-amber-300 bg-amber-100 px-2.5 py-1 text-xs font-medium text-amber-900 shadow-sm hover:bg-amber-200"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user-cog size-3.5" aria-hidden="true"><path d="M10 15H6a4 4 0 0 0-4 4v2"></path><path d="m14.305 16.53.923-.382"></path><path d="m15.228 13.852-.923-.383"></path><path d="m16.852 12.228-.383-.923"></path><path d="m16.852 17.772-.383.924"></path><path d="m19.148 12.228.383-.923"></path><path d="m19.53 18.696-.382-.924"></path><path d="m20.772 13.852.924-.383"></path><path d="m20.772 16.148.924.383"></path><circle cx="18" cy="15" r="3"></circle><circle cx="9" cy="7" r="4"></circle></svg>Impersonating<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down size-3.5" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></div>"`;

exports[`parity (switch off): impersonation banner > expanded renders as before and publishes the shell offset 1`] = `"<div><div role="status" class="fixed inset-x-0 top-0 z-(--z-banner) border-b border-amber-300 bg-amber-100 px-4 py-2 text-amber-900 shadow-sm"><div class="flex items-center justify-between gap-3"><div class="flex min-w-0 items-center gap-2 text-sm"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user-cog size-4 shrink-0" aria-hidden="true"><path d="M10 15H6a4 4 0 0 0-4 4v2"></path><path d="m14.305 16.53.923-.382"></path><path d="m15.228 13.852-.923-.383"></path><path d="m16.852 12.228-.383-.923"></path><path d="m16.852 17.772-.383.924"></path><path d="m19.148 12.228.383-.923"></path><path d="m19.53 18.696-.382-.924"></path><path d="m20.772 13.852.924-.383"></path><path d="m20.772 16.148.924.383"></path><circle cx="18" cy="15" r="3"></circle><circle cx="9" cy="7" r="4"></circle></svg><span class="truncate">You are impersonating <a class="font-semibold underline underline-offset-2 hover:text-amber-950" href="/user-management/users/u-9">Tan Mei Ling</a>. Anything you create or change is still recorded under your own account.</span></div><div class="flex items-center gap-2"><button data-slot="button" class="transition-[transform,scale,color,background-color,border-color,box-shadow] duration-(--duration-fast) ease-(--ease-standard) active:scale-[0.97] motion-reduce:active:scale-100 cursor-pointer group focus-visible:outline-hidden inline-flex items-center justify-center has-data-[arrow=true]:justify-between whitespace-nowrap font-medium ring-offset-background disabled:pointer-events-none disabled:opacity-60 [&amp;_svg]:shrink-0 border data-[state=open]:bg-accent h-7 rounded-md px-2.5 gap-1.25 text-xs [&amp;_svg:not([class*=size-])]:size-3.5 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 [&amp;_svg:not([role=img]):not([class*=text-]):not([class*=opacity-])]:opacity-60 shadow-xs shadow-black/5 border-amber-400 bg-white text-amber-900 hover:bg-amber-50"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-log-out size-3.5" aria-hidden="true"><path d="m16 17 5-5-5-5"></path><path d="M21 12H9"></path><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path></svg>Exit impersonation</button><button data-slot="button" class="transition-[transform,scale,color,background-color,border-color,box-shadow] duration-(--duration-fast) ease-(--ease-standard) active:scale-[0.97] motion-reduce:active:scale-100 cursor-pointer group focus-visible:outline-hidden inline-flex items-center justify-center has-data-[arrow=true]:justify-between whitespace-nowrap font-medium ring-offset-background disabled:pointer-events-none disabled:opacity-60 [&amp;_svg]:shrink-0 hover:text-accent-foreground data-[state=open]:bg-accent data-[state=open]:text-accent-foreground rounded-md gap-1.25 text-xs [&amp;_svg:not([class*=size-])]:size-3.5 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 shrink-0 w-7 h-7 p-0 [[&amp;_svg:not([class*=size-])]:size-3.5 text-amber-900 hover:bg-amber-200" aria-label="Hide banner" title="Hide banner"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-up size-4" aria-hidden="true"><path d="m18 15-6-6-6 6"></path></svg></button></div></div></div></div>"`;
