exports[`conversation pane parity (switch off) > pane: compact (contact record tab) 1`] = `"<div class="flex h-full flex-col" data-testid="conversation-drawer"><div class="flex min-h-0 flex-1 overflow-hidden"><div class="flex min-h-0 min-w-0 flex-1 flex-col"><div dir="ltr" data-slot="scroll-area" class="relative overflow-hidden min-h-0 flex-1" style="position: relative; --radix-scroll-area-corner-width: 0px; --radix-scroll-area-corner-height: 0px;"><style>[data-radix-scroll-area-viewport]{scrollbar-width:none;-ms-overflow-style:none;-webkit-overflow-scrolling:touch;}[data-radix-scroll-area-viewport]::-webkit-scrollbar{display:none}</style><div data-radix-scroll-area-viewport="" class="h-full w-full rounded-[inherit]" style="overflow-x: hidden; overflow-y: scroll;"><div style="min-width: 100%; display: table;"><div class="flex flex-col gap-2.5 p-4" data-testid="thread-window"><div class="flex justify-center py-1"><span class="rounded-full bg-muted px-3 py-1 text-xs font-medium text-muted-foreground shadow-xs" data-testid="day-pill">Today</span></div><div><div class="flex justify-start" data-testid="bubble-contact" data-state="closed" data-slot="context-menu-trigger"><div class="max-w-[75%]"><div class="rounded-2xl px-3.5 py-2 text-sm shadow-xs rounded-bl-sm bg-muted text-foreground"><p class="whitespace-pre-wrap break-words">Hi! I booked the Grand Ballroom for Friday.</p><div class="mt-0.5 flex items-center justify-end gap-1 text-2xs text-muted-foreground">HH:MM</div></div></div></div></div><div><div class="flex justify-end" data-testid="bubble-agent" data-state="closed" data-slot="context-menu-trigger"><div class="max-w-[75%]"><div class="rounded-2xl px-3.5 py-2 text-sm shadow-xs rounded-br-sm bg-primary-soft text-foreground"><p class="whitespace-pre-wrap break-words">Hi Sarah! Yes, I can see your booking - Friday 7pm, 120 pax.</p><div class="mt-0.5 flex items-center justify-end gap-1 text-2xs text-muted-foreground">HH:MM<svg xmlns="http://www.w3.org/2000/svg" width