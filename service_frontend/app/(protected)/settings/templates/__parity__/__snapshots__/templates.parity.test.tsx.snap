exports[`template record (switch off) > edits the design and settings and saves the same document as today > save calls 1`] = `
[
  [
    "template.update",
    "tpl-1",
    {
      "context": "auth.user",
      "doc": {
        "schemaVersion": 1,
        "sections": [
          {
            "background": null,
            "columns": [
              {
                "blocks": [
                  {
                    "id": "blk_brand",
                    "overrides": null,
                    "type": "brandHeader",
                  },
                ],
                "id": "col_head",
              },
            ],
            "id": "sec_head",
            "layout": "100",
            "padding": {
              "bottom": 0,
              "left": 0,
              "right": 0,
              "top": 0,
            },
          },
          {
            "background": "#FFFFFF",
            "columns": [
              {
                "blocks": [
                  {
                    "align": "left",
                    "id": "blk_head",
                    "level": 2,
                    "text": "Hello {{recipient.firstName}}",
                    "type": "heading",
                  },
                  {
                    "align": "left",
                    "html": "Your account is <b>ready</b>. Sign in today.<b>bold</b><i>italic</i><ul><li>item</li></ul><a href="https://maju.my/start">link</a>{{recipient.firstName}}",
                    "id": "blk_text",
                    "type": "text",
                  },
                ],
                "id": "col_body",
              },
            ],
            "id": "sec_body",
            "layout": "100",
            "padding": {
              "bottom": 16,
              "left": 24,
              "right": 24,
              "top": 16,
            },
          },
          {
            "background": null,
            "columns": [
              {
                "blocks": [
                  {
                    "id": "blk_footer",
                    "overrides": null,
                    "type": "brandFooter",
                  },
                ],
                "id": "col_foot",
              },
            ],
            "id": "sec_foot",
            "layout": "100",
            "padding": {
              "bottom": 0,
              "left": 0,
              "right": 0,
              "top": 0,
            },
          },
        ],
      },
      "name": "Welcome email v2",
      "subject": "Welcome aboard, {{recipient.firstName}}",
    },
  ],
  [
    "toast.success",
    "Template saved.",
  ],
]
`;

