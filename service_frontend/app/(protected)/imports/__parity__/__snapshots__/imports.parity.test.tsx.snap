exports[`switch-off parity: import dialog > downloads the template with the same request 2`] = `
[
  [
    "import.getConfig",
    "user",
  ],
  [
    "import.downloadTemplate",
    "user",
    [
      "name",
      "email",
      "phone",
    ],
    "xlsx",
  ],
