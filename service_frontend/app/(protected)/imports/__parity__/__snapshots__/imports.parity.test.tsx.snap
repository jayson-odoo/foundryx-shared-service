exports[`switch-off parity: import dialog > renders as today and uploads the same request 2`] = `
[
  [
    "import.getConfig",
    "user",
  ],
  [
    "import.create",
    {
      "abortOnInvalid": false,
      "entityType": "user",
      "file": "users.csv",
      "mode": "create_only",
      "triggerAutomations": false,
    },
  ],
  [
    "onClose",
  ],
  [
    "router.push",
    "/imports/imp-1?from=%2Fuser-management%2Fusers",
  ],
]
`;

