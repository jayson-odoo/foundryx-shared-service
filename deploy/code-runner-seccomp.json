{
  "_comment": "Foundryx Code runner seccomp profile (docker-compose.yml code_runner). The runner only ever ACCEPTS connections from the backend on the internal network; it never dials out. Denying connect() (and sendto() with a destination address) makes a jail escape unable to reach any peer even inside the internal network. Everything Docker's default profile denies for privilege/namespace/kernel reach is denied here too, since a custom profile replaces the default.",
  "defaultAction": "SCMP_ACT_ALLOW",
  "architectures": ["SCMP_ARCH_X86_64", "SCMP_ARCH_X86", "SCMP_ARCH_X32", "SCMP_ARCH_AARCH64", "SCMP_ARCH_ARM"],
  "syscalls": [
    {
      "names": ["connect", "sendmmsg"],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1
    },
    {
      "names": ["sendto"],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1,
      "args": [{"index": 5, "value": 0, "op": "SCMP_CMP_NE"}]
    },
    {
      "names": [
        "acct", "add_key", "bpf", "clock_adjtime", "clock_settime", "create_module", "delete_module",
        "finit_module", "get_kernel_syms", "get_mempolicy", "init_module", "ioperm", "iopl", "kcmp",
        "kexec_file_load", "kexec_load", "keyctl", "lookup_dcookie", "mbind", "mount", "move_mount",
        "move_pages", "name_to_handle_at", "nfsservctl", "open_by_handle_at", "perf_event_open",
        "personality", "pivot_root", "process_vm_readv", "process_vm_writev", "ptrace", "query_module",
        "quotactl", "reboot", "request_key", "set_mempolicy", "setns", "settimeofday", "stime",
        "swapon", "swapoff", "sysfs", "_sysctl", "umount", "umount2", "unshare", "uselib", "userfaultfd",
        "ustat", "vm86", "vm86old", "fsconfig", "fsmount", "fsopen", "fspick", "open_tree"
      ],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1
    }
  ]
}
